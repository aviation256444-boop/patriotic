# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Patriotic Youths of Uganda
NEXT_PUBLIC_DEMO_MODE=false

# ─── PawaPay (MTN + Airtel donations) ─────────────────────────────────────
# Live token → production API. Sandbox token → sandbox API.
# Permanent host callbacks:
#   https://YOUR-APP.onrender.com/api/payments/pawapay/callback
#
NEXT_PUBLIC_PAWAPAY_ENABLED=true
# sandbox | production
PAWAPAY_ENV=production
NEXT_PUBLIC_PAWAPAY_ENV=production
PAWAPAY_BASE_URL=https://api.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_COUNTRY=UGA
PAWAPAY_CURRENCY=UGX
# PAWAPAY_MTN_CORRESPONDENT=MTN_MOMO_UGA
# PAWAPAY_AIRTEL_CORRESPONDENT=AIRTEL_OAPI_UGA

# ─── MTN MoMo Collections (fallback if PawaPay not configured) ─────────────
# Portal: https://momodeveloper.mtn.com  → subscribe to **Collections**
# Flow: donor phone → MTN RequestToPay → donor enters MoMo PIN on phone
#       → MTN charges exact amount → we poll until SUCCESSFUL
#
NEXT_PUBLIC_MOMO_ENABLED=true
# sandbox | production
NEXT_PUBLIC_MOMO_ENV=sandbox
NEXT_PUBLIC_MOMO_CURRENCY=UGX

# Sandbox: create API user with: npm run momo:setup -- YOUR_COLLECTIONS_KEY
NEXT_PUBLIC_MOMO_API_USER_ID=
MOMO_API_USER_ID=
MOMO_API_KEY=
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_SUBSCRIPTION_KEY=

# Sandbox base (default)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_HOST=http://localhost:3000

# Optional: force API currency in sandbox if UGX is rejected (some tenants use EUR)
# MOMO_API_CURRENCY=EUR
# MOMO_SANDBOX_USE_EUR=true

# ─── PRODUCTION (real money in Uganda) ─────────────────────────────────────
# 1. Complete MTN Go-Live / Partner onboarding for Collections (Uganda)
# 2. Get production subscription key + create production API User + API Key
# 3. Set:
# NEXT_PUBLIC_MOMO_ENV=production
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# MOMO_TARGET_ENVIRONMENT=mtnuganda
# NEXT_PUBLIC_MOMO_CURRENCY=UGX
# MOMO_COLLECTION_SUBSCRIPTION_KEY=prod_key
# MOMO_API_USER_ID=prod_uuid
# MOMO_API_KEY=prod_api_key
# NEXT_PUBLIC_APP_URL=https://your-live-domain.com
# MOMO_CALLBACK_HOST=https://your-live-domain.com

# ─── Airtel Money Collection (Sandbox Collection-API's.json) ───────────────
# Auth:     POST https://openapi.airtel.ug/auth/oauth2/token
# Payments: POST https://openapi.airtel.ug/simulate/merchant/v1/payments/
# Enquiry:  GET  https://openapi.airtel.ug/simulate/standard/v1/payments/{id}
NEXT_PUBLIC_AIRTEL_ENABLED=true
AIRTEL_ENV=sandbox
AIRTEL_BASE_URL=https://openapi.airtel.ug
AIRTEL_API_VERSION=v1
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# Production: AIRTEL_ENV=production and paths drop /simulate automatically
# AIRTEL_API_VERSION=v2  # optional — Collection-API also has Payments V2

# ─── Square (Visa / Mastercard via Web Payments SDK) ───────────────────────
# https://developer.squareup.com/console → your app → Credentials
NEXT_PUBLIC_SQUARE_ENABLED=true
SQUARE_ENV=sandbox
NEXT_PUBLIC_SQUARE_ENV=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# Secret — never commit real tokens
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_LOCATION_ID=
