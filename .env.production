# Public production defaults baked into the Next.js client at build time.
# Safe to commit: OAuth Web Client IDs are public (not secrets).
# Secrets (PAWAPAY_API_TOKEN, etc.) must stay in Render Environment only.

NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_NAME=Patriotic Youths of Uganda
NEXT_PUBLIC_APP_URL=https://patriotic-app.onrender.com

# Google OAuth (account picker login / auto-register)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=868445110488-pj1f968b1a5f444bva2hkl9gc4v550uu.apps.googleusercontent.com

# Payments UI flags
NEXT_PUBLIC_PAWAPAY_ENABLED=true
NEXT_PUBLIC_PAWAPAY_ENV=production
NEXT_PUBLIC_MOMO_ENABLED=true
NEXT_PUBLIC_MOMO_CURRENCY=UGX
NEXT_PUBLIC_AIRTEL_ENABLED=true
NEXT_PUBLIC_SQUARE_ENABLED=true
NEXT_PUBLIC_SQUARE_ENV=production
