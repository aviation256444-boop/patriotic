/data/users.json
/data/users.json.bak
/data/users.json.*
/data/activity-log.json
/data/activity-log.json.bak
/data/tickets.json
/data/tickets.json.bak
/data/backups/
/data/*.tmp

# uploaded images (keep folder)
/public/uploads/*
!/public/uploads/.gitkeep
/data/uploads/*
!/data/uploads/.gitkeep

# secrets / local
.env
.env.production.local
